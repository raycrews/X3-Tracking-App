{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X3 Workout Tracker",
  "version": "0.1.0",
  "identifier": "com.x3workout.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "X3 Workout Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
